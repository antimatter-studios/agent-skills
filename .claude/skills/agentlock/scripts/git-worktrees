#!/usr/bin/env bash
# git worktrees — every worktree of this repository, with who holds it and whether it is safe to take.
#
# `git worktree list` gives a path and a branch. What it never says is who made one, when, why, and
# whether anything would be lost by removing it — which is the whole of what somebody sweeping
# stale worktrees actually needs. This reads the same list and adds the four missing columns from
# `.agentlock` (see `git agentlock`), the index, and the worktree's own lock.
#
# STATE is the column to read, and it is deliberately conservative:
#
#   dirty(N)   N uncommitted paths. Never remove one on the strength of this tool.
#   locked     `git worktree lock` was used. Somebody meant it.
#   held       an .agentlock names an owner.
#   free       clean, unlocked, unclaimed. The only state that invites removal, and even then
#              whether the branch has landed is a question this does not answer.
#
# Advisory. It explains worktrees; it does not protect them and it removes nothing.
set -euo pipefail

git rev-parse --git-dir >/dev/null 2>&1 || { echo 'not inside a git worktree' >&2; exit 1; }

age_of() {
  # Whole hours or days since an ISO-8601 stamp, or from a file's mtime when there is no stamp.
  local when=$1 secs now
  now=$(date -u '+%s')
  if [ -f "$when" ]; then
    secs=$(stat -f '%m' "$when" 2>/dev/null || stat -c '%Y' "$when" 2>/dev/null || echo "$now")
  else
    secs=$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$when" '+%s' 2>/dev/null \
        || date -u -d "$when" '+%s' 2>/dev/null || echo "$now")
  fi
  local d=$(( (now - secs) / 60 ))
  if   [ "$d" -lt 60   ]; then printf '%dm' "$d"
  elif [ "$d" -lt 1440 ]; then printf '%dh' $((d / 60))
  else                         printf '%dd' $((d / 1440)); fi
}

printf '%-52s %-32s %-18s %-6s %s\n' PATH BRANCH OWNER AGE STATE

here=$(git rev-parse --show-toplevel)
git worktree list --porcelain | awk '
  /^worktree /{ path=substr($0,10) }
  /^branch /  { br=substr($0,8); sub("refs/heads/","",br) }
  /^detached/ { br="(detached)" }
  /^locked/   { lk=1 }
  /^$/        { if (path) print path "\t" (br?br:"?") "\t" (lk?"locked":"") ; path=""; br=""; lk=0 }
  END         { if (path) print path "\t" (br?br:"?") "\t" (lk?"locked":"") }
' | while IFS=$'\t' read -r path branch locked; do
  [ -d "$path" ] || { printf '%-52s %-32s %-18s %-6s %s\n' "$path" "$branch" '—' '—' 'MISSING'; continue; }

  owner='—'; age='—'
  if [ -f "$path/.agentlock" ]; then
    owner=$(sed -n 's/^agent: //p' "$path/.agentlock" | head -1)
    since=$(sed -n 's/^since: //p' "$path/.agentlock" | head -1)
    age=$(age_of "${since:-$path/.agentlock}")
  fi

  dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  state=''
  [ "$dirty" != '0' ] && state="dirty($dirty)"
  [ -n "$locked" ]    && state="${state:+$state, }locked"
  [ "$owner" != '—' ] && state="${state:+$state, }held"
  [ -z "$state" ]     && state='free'

  # A scratchpad path is mostly session id, which is the least interesting part of it. Keep the
  # head and the tail and elide the middle, so the column stays readable at a glance.
  show=$path
  case "$path" in "$here") show='.' ;; "$here"/*) show=".${path#$here}" ;; "$HOME"/*) show="~${path#$HOME}" ;; esac
  if [ ${#show} -gt 52 ]; then show="${show:0:20}…${show: -31}"; fi
  printf '%-52s %-32s %-18s %-6s %s\n' "$show" "$branch" "$owner" "$age" "$state"
done
